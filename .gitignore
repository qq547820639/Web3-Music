.env
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
coverage.xml
htmlcov/
.env.generated
backups/

# WorkBuddy agent data (not part of source)
.workbuddy/

# Drill runtime state (scripts/restore_fidelity.py, scripts/lease_contention.py)
.restore-fidelity.json
.lease-contention-state.json
.chaos-state.json

# Keep each acceptance-all run's step verdicts auditable without committing the
# multi-megabyte compose logs alongside them.
release-evidence/*
!release-evidence/acceptance-*/
release-evidence/acceptance-*/*
!release-evidence/acceptance-*/SUMMARY.txt
!release-evidence/browser-a11y-*/
release-evidence/browser-a11y-*/*
!release-evidence/browser-a11y-*/report.json

# Pinned third-party audit script cached by scripts/browser_a11y.py.
.cache/
