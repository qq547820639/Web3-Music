{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://local.resonance/contracts/song-spec-runtime-v1.schema.json",
  "title":"SongSpecRuntimeV1",
  "type":"object",
  "required":["title","language","theme","mood","genre","bpm","vocal","hook","styles","lyrics","structure"],
  "properties":{
    "title":{"type":"string","minLength":1,"maxLength":120},
    "language":{"type":"string","minLength":2,"maxLength":20},
    "theme":{"type":"string","minLength":1,"maxLength":300},
    "mood":{"type":"array","minItems":1,"maxItems":12,"items":{"type":"string","minLength":1,"maxLength":60}},
    "genre":{"type":"string","minLength":1,"maxLength":200},
    "bpm":{"type":"integer","minimum":40,"maximum":220},
    "vocal":{"type":"object","required":["type","delivery"],"properties":{"type":{"type":"string","maxLength":80},"delivery":{"type":"string","maxLength":300}},"additionalProperties":true},
    "hook":{"type":"string","minLength":1,"maxLength":80},
    "styles":{"type":"string","minLength":10,"maxLength":4000},
    "lyrics":{"type":"string","minLength":20,"maxLength":30000},
    "structure":{"type":"object","required":["sections"],"properties":{"sections":{"type":"array","minItems":1,"maxItems":40,"items":{"type":"string","minLength":1,"maxLength":80}}},"additionalProperties":true}
  },
  "additionalProperties":true
}
