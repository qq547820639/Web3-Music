{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DomainEventEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "aggregateType",
    "aggregateId",
    "workspaceId",
    "occurredAt",
    "actor",
    "correlationId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string"
    },
    "eventVersion": {
      "type": "integer",
      "minimum": 1
    },
    "aggregateType": {
      "type": "string"
    },
    "aggregateId": {
      "type": "string"
    },
    "workspaceId": {
      "type": "string",
      "format": "uuid"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "user",
            "system",
            "ai_agent",
            "provider",
            "admin"
          ]
        },
        "id": {
          "type": "string"
        }
      }
    },
    "correlationId": {
      "type": "string"
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "traceId": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    }
  }
}
