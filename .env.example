# Resonance v13 local defaults. Copy to .env before docker compose up --build.

# DeepSeek is optional. When empty, a deterministic local Patch proposer is used.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Local acceptance uses the provider emulator.
# Production can use generic_rest only after a written provider contract is approved.
MUSIC_PROVIDER=emulator
PROVIDER_APPROVAL_STATUS=development_only
PROVIDER_CONTRACT_VERSION=local-emulator-v1
PROVIDER_ADAPTER_VERSION=3.0.0
GENERATION_CREDIT_PER_CANDIDATE=10

# Generic approved provider adapter
GENERIC_PROVIDER_BASE_URL=
GENERIC_PROVIDER_API_KEY=
GENERIC_PROVIDER_MODEL=
GENERIC_PROVIDER_SUBMIT_PATH=/v1/jobs
GENERIC_PROVIDER_STATUS_PATH=/v1/jobs/{job_id}
GENERIC_PROVIDER_CANCEL_PATH=/v1/jobs/{job_id}/cancel

# Community bridge remains development-only and never grants commercial capabilities.
SUNO_API_BASE_URL=
SUNO_MODEL=chirp-v3-0

# Browser session, media, webhook and payment secrets.
#
# These are demo values and the repository names them as such, which is the whole point: CI runs
# `cp .env.example .env` and the base Compose file pins DEMO_STACK=true, so a deployment that means
# business has to change this file *or* lose the boot. Two rules the API enforces at startup when
# DEMO_STACK is not true: no value below may equal a literal that appears in this repository, and no
# two purposes may share one value.
#
# The last rule is why JWT_SECRET and MEDIA_SIGNING_SECRET used to both read "change-me-before-sharing"
# here: copied verbatim, that file gave the platform one secret for signing access tokens and for
# signing media URLs, so anyone who learned the media secret could mint a session.
JWT_SECRET=local-demo-jwt-secret-not-a-real-secret-5f2a
JWT_TTL_MINUTES=30
REFRESH_TTL_DAYS=14
COOKIE_SECURE=false
COOKIE_DOMAIN=
MEDIA_SIGNING_SECRET=local-demo-media-secret-not-a-real-secret-c81d
PROVIDER_WEBHOOK_SECRET=local-demo-provider-webhook-secret-4b7e
MODERATION_POLICY_VERSION=policy-v1
REQUEST_RATE_LIMIT_PER_MINUTE=300
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Pepper for auth_sessions.ip_hash. An unsalted digest of an IPv4 address is brute-forceable over
# the whole address space, so this column is only a pseudonym while this value stays secret.
ADDRESS_PEPPER=local-demo-address-pepper-not-a-real-secret-3e9b
# How many DIFFERENT accounts one source may get wrong per minute before the source is held.
# Deliberately accounts rather than attempts -- see _source_gate in services/api/app/main.py.
LOGIN_SOURCE_RATE_LIMIT_PER_MINUTE=20
REPORT_RATE_LIMIT_PER_MINUTE=6
REPORT_GLOBAL_RATE_LIMIT_PER_MINUTE=30

# Payment emulator / gateway adapter
PAYMENT_PROVIDER=emulator
PAYMENT_WEBHOOK_SECRET=local-demo-payment-webhook-secret-9a3c
PAYMENT_BASE_URL=http://payment-emulator:8020
PUBLIC_API_BASE_URL=http://api:8000

# Capacity/cost controls (v14 defaults)
API_WORKERS=1
API_LIMIT_CONCURRENCY=512
API_KEEPALIVE_SECONDS=5
DB_POOL_MIN=2
DB_POOL_MAX=16
DB_POOL_ACQUIRE_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
WORKER_CONCURRENCY=8
WORKER_DB_POOL_MIN=2
WORKER_DB_POOL_MAX=16
CLAIM_IDLE_SLEEP_SECONDS=0.35
POLL_WINDOW_SECONDS=600
PROVIDER_POLL_INTERVAL_SECONDS=3
PROVIDER_POLL_MAX_INTERVAL_SECONDS=10
# 媒体扫描边界（db/migrations/020_media_scan_truth.sql）。留空 = 这台部署没有引擎，
# 资产就老实记 unscanned；填了 host:port（例如 compose profile `scan` 里的 clamav:3310）
# 就必须拿到判决才准落桶，引擎不可达时作业整条重试，绝不默认放行。
MEDIA_SCAN_ENDPOINT=
MEDIA_SCAN_TIMEOUT_SECONDS=120
# Use presigned delivery in production so audio does not traverse API containers.
MEDIA_DELIVERY_MODE=proxy
S3_PUBLIC_ENDPOINT_URL=

# Host ports for the published edge/metrics containers. Override when another
# stack already owns 8080/9090 on the same Docker host -- on this machine a
# foreign service did own 8080, and a curl against the assumed port reads
# someone else's app. Scripts ask compose instead: `docker compose port gateway 80`
# (see scripts/smoke.sh), which is the only reader of what is actually published.
GATEWAY_PORT=8080
PROMETHEUS_PORT=9090
# Second factor (TOTP). MFA_ENCRYPTION_KEY has no in-file default in the code: without it the
# /api/auth/mfa endpoints fail closed, so set a real value anywhere second factors are enabled.
MFA_ENCRYPTION_KEY=local-development-mfa-key-change-before-production-0123456789abcdef
MFA_ENROLMENT_WINDOW_SECONDS=900
MFA_PENDING_TTL_SECONDS=300
MFA_CHALLENGE_RATE_LIMIT_PER_MINUTE=6

# Tunables the code already defaults to. Listed here so this file is the whole configuration
# contract rather than a partial one: a deployer who greps for a name and finds nothing has no way
# to know the knob exists. Each value below equals the in-code default, so copying the file changes
# nothing.
MEDIA_TOKEN_TTL_SECONDS=300
PAYMENT_TIMEOUT_SECONDS=60
PROVIDER_HTTP_MAX_CONNECTIONS=64
MEDIA_TRANSPORT_ATTEMPTS=3
GENERIC_PROVIDER_CAPABILITIES_PATH=/v1/capabilities
GENERIC_PROVIDER_HEALTH_PATH=/health
GENERIC_PROVIDER_AUTH_HEADER=Authorization
# GENERIC_PROVIDER_AUTH_PREFIX is deliberately absent: its in-code default is "Bearer " with a
# trailing space, and a value written into this file would be read back through two parsers
# (compose, then python-dotenv) that do not agree on keeping it. Documenting the knob here would
# therefore change the Authorization header it feeds, which is the opposite of "equals the default".
